{
  "expo": {
    "name": "SouvLucky",
    "slug": "souvlucky",
    "owner": "stephennn",
    "scheme": "souvlucky",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3EDE1",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand/adaptive-icon.png",
        "backgroundColor": "#F3EDE1"
      }
    },
    "web": {
      "favicon": "./assets/images/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EDE1"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-video",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "SouvLucky uses your photos to set your profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
